#! Macros
# By default, set as binary. Can be overridden in template for lfs support
[attr]lfs_maybe     binary

#! General Rules
# Auto detect text files and perform LF normalization unless set below
*                   text=auto

#! Exclude files from exporting
.gitattributes      export-ignore
.gitignore          export-ignore
.gitkeep            export-ignore

#! General Formats
#* Git
.gitattributes      text
.gitignore          text
#* Documents
*.md                text diff=markdown
*.mdx               text diff=markdown
*.rtf               text diff=astextplain
*.pdf               lfs_maybe
*.epub              text diff=astextplain
*.bib               text diff=bibtex
*.tex               text diff=tex
*.adoc              text
*.csv               text
*.tsv               text
*.txt               text
*.ipynb             text eol=lf
#* Configs
*.ini               text
*.cnf               text
*.conf              text
*.config            text
*.env               text
#* Serialization
*.json              text
*.jsonc             text
*.json5             text
*.toml              text
*.xml               text
*.yaml              text
*.yml               text
# Fixes syntax highlighting on GitHub to allow comments
.vscode/*.json      linguist-language=JSON-with-Comments
#* Scripts
*.sh                text eol=lf
*.bash              text eol=lf
*.fish              text eol=lf
*.ksh               text eol=lf
*.zsh               text eol=lf
*.sql               text linguist-detectable linguist-language=sql
