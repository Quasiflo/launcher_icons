{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "dart",
      "extra-label": "Bot 🤖",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "generic",
          "path": "lib/src/version.dart"
        },
        {
          "type": "generic",
          "path": "README.md"
        },
        {
          "type": "generic",
          "path": ".github/ISSUE_TEMPLATE/bug_report.yml"
        }
      ]
    }
  }
}
