{
    //! Editor Behaviour
    "editor.wordWrap": "on", // files use continuous lines, never hard-wrapped; the editor wraps visually
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.associations": {
        "LICENSE": "txt",
        "CODEOWNERS": "txt",
        ".pubignore": "txt"
    },
    //! Visuals
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "pubspec.yaml": "pubspec.lock,pubspec_overrides.yaml,.packages,.flutter-plugins,.flutter-plugins-dependencies,.metadata,analysis_options.yaml,dart_test.yaml,.pubignore,build.yaml",
        "*.dart": "${capture}.g.dart",
        ".gitignore": ".gitattributes",
        "rp-config.json": "rp-manifest.json",
        "mise.toml": "mise*.toml,mise*.lock,miserc.toml",
        "README.md": "REPOSITORY.md,ARCHITECTURE.md,TODO.md,CONTRIBUTING.md,CHANGELOG.md,AGENTS.md,ROADMAP.md,LICENSE",
    },
    //! Language & Plugin
    //* Dart & Flutter
    "[dart]": {
        "editor.selectionHighlight": false, // Let dart choose which instances of selected words to highlight rather than all of them
        "editor.wordBasedSuggestions": "off", // Let dart choose the autocompletes
        "editor.codeActionsOnSave": {
            "source.fixAll": "never",
            "source.organizeImports": "never"
        }
    },
    //* Markdown
    "[markdown]": {
        "editor.defaultFormatter": "rvben.rumdl"
    },
    "rumdl.lint.run": "onSave",
    //* Mise
    "mise.checkForNewMiseVersion": false,
    "mise.configureExtensionsAutomatically": false, // TODO fix
    "mise.configureExtensionsUseSymLinks": true,
    "mise.configureExtensionsIncludeGlobalTools": false,
    //! Ignored Values
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/.cache": true,
        "**/Thumbs.db": true,
        "**/.dart_tool": true,
        "**/.rumdl_cache": true,
        "**/.vscode/mise-tools": true
    },
    "dart.flutterSdkPath": ".vscode/mise-tools/flutter",
    "cmake.cmakePath": "${workspaceFolder}/.vscode/mise-tools/cmake",
    // "java.import.gradle.java.home": "${workspaceFolder}/.vscode/mise-tools/java",
    // "java.jdt.ls.java.home": "${workspaceFolder}/.vscode/mise-tools/java",
    "cSpell.enabled": false,
}
